# ps5-adblock example configuration. Copy to /data/ps5-adblock/config.ini.
# See docs/config.md for every key.

[general]
debug=0
# quiet=1 hides the start notification (errors are always shown)
quiet=0
# autostart=1 keeps the payload in etaHEN/onionHEN payloads/ so it starts with the HEN
autostart=1
# 0.0.0.0 serves every device on the LAN, not just the console
bind=127.0.0.1
# IPv6 listener address, or off
bind6=::1

[upstream]
# tried in order; timeout_ms is the total budget for one query
server=1.1.1.1
server=9.9.9.9
timeout_ms=1500

[overrides]
# mask=IPv4
*.doubleclick.net=0.0.0.0
nas.home=192.168.1.10

[exceptions]
*.stun.playstation.net

[blocking]
# null answers 0.0.0.0 / ::, nxdomain answers "no such domain"
block_mode=null
# blocked domains come from every .txt file in lists/; allowlist.txt wins over them
max_domains=1500000
# preset=update-block   blocks firmware updates and PSN (PSN features stop working)

[lists]
# url=<name>|<https url>: downloaded to lists/<name>.txt and kept up to date
url=hagezi-pro|https://raw.githubusercontent.com/hagezi/dns-blocklists/main/wildcard/pro-onlydomains.txt
url=hagezi-popupads|https://raw.githubusercontent.com/hagezi/dns-blocklists/main/wildcard/popupads-onlydomains.txt
# hours between checks, 0 never downloads
update_hours=24
